# انسخ الملف ده باسم .env واملا القيم الحقيقية
# لعمل SECRET_KEY جديد:
#   .\venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(50))"

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=legal_db
